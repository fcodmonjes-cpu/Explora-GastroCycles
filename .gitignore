# Secrets y archivos sensibles — nunca commitear
firebase-rules.json
*.key.json
*-key.json
.env
.env.*

# Archivos de trabajo locales
*.seed.json
*.xlsx
*.pdf
*.m4a
*.png
*.svg
!Explora.png
!favicon.svg
# Reference images attached to checklist tasks (montaje, etc.) live in assets/
# and are versioned regardless of extension.
!assets/**

# Notas de versión (documento vivo): el PDF de docs/ sí se versiona.
!docs/notas-de-version.pdf

# Configuración local del asistente (worktrees, settings por máquina). No es
# del proyecto y ensuciaba `git status` en cada sesión.
.claude/

# Python
__pycache__/
*.pyc

# Estudio de menús: copia LOCAL de los audios para QA en localhost. En los
# deploys el módulo lee de Firebase Storage (ver ARCHITECTURE.md §3.4); esto
# no se versiona nunca — son ~35-70 MB que cada deployment copiaría entero.
/estudio-local/

# Quincho: la planilla (.xlsx, ya ignorada arriba), los carteles y los roster
# llevan nombres completos con su habitación. Se generan con
# scripts/quincho.py y no se versionan nunca.
quincho-*-carteles.html
quincho-*.json
